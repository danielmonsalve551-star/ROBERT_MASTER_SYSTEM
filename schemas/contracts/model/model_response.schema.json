{
  "$defs": {
    "JsonValue": {}
  },
  "$id": "schemas/contracts/model/model_response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "citations_or_evidence": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Citations Or Evidence",
      "type": "array"
    },
    "confidence_if_applicable": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Confidence If Applicable"
    },
    "contract_version": {
      "const": "0.1",
      "title": "Contract Version",
      "type": "string"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Errors",
      "type": "array"
    },
    "memory_candidates": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Memory Candidates",
      "type": "array"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "output": {
      "$ref": "#/$defs/JsonValue"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "reasoning_summary_if_available": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reasoning Summary If Available"
    },
    "request_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "status": {
      "minLength": 1,
      "title": "Status",
      "type": "string"
    },
    "structured_output": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Structured Output"
    },
    "task_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "tool_requests": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Tool Requests",
      "type": "array"
    },
    "usage_metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Usage Metadata",
      "type": "object"
    },
    "validation_requests": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Validation Requests",
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "task_id",
    "model_id",
    "provider",
    "status",
    "output",
    "structured_output",
    "reasoning_summary_if_available",
    "tool_requests",
    "memory_candidates",
    "validation_requests",
    "confidence_if_applicable",
    "citations_or_evidence",
    "warnings",
    "errors",
    "usage_metadata"
  ],
  "title": "ModelResponse",
  "type": "object",
  "x-robert-contract-name": "MODEL_RESPONSE",
  "x-robert-contract-owner": "model"
}

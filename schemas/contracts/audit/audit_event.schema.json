{
  "$defs": {
    "JsonValue": {}
  },
  "$id": "schemas/contracts/audit/audit_event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "actor": {
      "minLength": 1,
      "title": "Actor",
      "type": "string"
    },
    "approval_state": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Approval State",
      "type": "object"
    },
    "component": {
      "minLength": 1,
      "title": "Component",
      "type": "string"
    },
    "contract_version": {
      "const": "0.1",
      "title": "Contract Version",
      "type": "string"
    },
    "error_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Ref"
    },
    "event_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "minLength": 1,
      "title": "Event Type",
      "type": "string"
    },
    "input_refs": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "output_refs": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Output Refs",
      "type": "array"
    },
    "permission_state": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Permission State",
      "type": "object"
    },
    "result": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Result",
      "type": "object"
    },
    "risk_state": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Risk State",
      "type": "object"
    },
    "scope_state": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Scope State",
      "type": "object"
    },
    "target": {
      "minLength": 1,
      "title": "Target",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "validation_state": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Validation State",
      "type": "object"
    }
  },
  "required": [
    "contract_version",
    "event_id",
    "task_id",
    "timestamp",
    "event_type",
    "actor",
    "component",
    "action",
    "target",
    "input_refs",
    "output_refs",
    "permission_state",
    "scope_state",
    "risk_state",
    "approval_state",
    "validation_state",
    "result",
    "error_ref",
    "metadata"
  ],
  "title": "AuditEvent",
  "type": "object",
  "x-robert-contract-name": "AUDIT_EVENT",
  "x-robert-contract-owner": "audit"
}

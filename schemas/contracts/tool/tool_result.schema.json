{
  "$defs": {
    "JsonValue": {}
  },
  "$id": "schemas/contracts/tool/tool_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audit_reference": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Audit Reference"
    },
    "confidence_if_applicable": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Confidence If Applicable"
    },
    "contract_version": {
      "const": "0.1",
      "title": "Contract Version",
      "type": "string"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Errors",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "operation": {
      "minLength": 1,
      "title": "Operation",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/JsonValue"
    },
    "side_effects": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Side Effects",
      "type": "array"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "status": {
      "minLength": 1,
      "title": "Status",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "tool_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Tool Id",
      "type": "string"
    },
    "validation_required": {
      "title": "Validation Required",
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "task_id",
    "tool_id",
    "operation",
    "status",
    "result",
    "metadata",
    "source",
    "timestamp",
    "side_effects",
    "warnings",
    "errors",
    "confidence_if_applicable",
    "validation_required",
    "audit_reference"
  ],
  "title": "ToolResult",
  "type": "object",
  "x-robert-contract-name": "TOOL_RESULT",
  "x-robert-contract-owner": "tool"
}

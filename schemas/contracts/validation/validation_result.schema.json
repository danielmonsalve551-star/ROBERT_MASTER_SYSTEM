{
  "$defs": {
    "JsonValue": {},
    "ValidationStatus": {
      "enum": [
        "PASS",
        "PASS_WITH_WARNINGS",
        "FAIL",
        "INCONCLUSIVE",
        "NOT_APPLICABLE"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "$id": "schemas/contracts/validation/validation_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audit_reference": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Audit Reference"
    },
    "blocking": {
      "title": "Blocking",
      "type": "boolean"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Checks",
      "type": "array"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Confidence"
    },
    "contract_version": {
      "const": "0.1",
      "title": "Contract Version",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Evidence",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Issues",
      "type": "array"
    },
    "limitations": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Limitations",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "recommended_next_step": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Recommended Next Step"
    },
    "requester": {
      "minLength": 1,
      "title": "Requester",
      "type": "string"
    },
    "reviewer_refs": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Reviewer Refs",
      "type": "array"
    },
    "severity": {
      "minLength": 1,
      "title": "Severity",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Sources",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ValidationStatus"
    },
    "target_ref": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Target Ref",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "validation_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Validation Id",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "validation_id",
    "task_id",
    "requester",
    "target_ref",
    "status",
    "checks",
    "issues",
    "severity",
    "evidence",
    "sources",
    "confidence",
    "limitations",
    "recommendations",
    "recommended_next_step",
    "blocking",
    "reviewer_refs",
    "timestamp",
    "audit_reference"
  ],
  "title": "ValidationResult",
  "type": "object",
  "x-robert-contract-name": "VALIDATION_RESULT",
  "x-robert-contract-owner": "validation"
}
